{
  "name": "dunasjs",
  "version": "0.0.2",
  "description": "Billing for Brazil: plans, usage and subscriptions by Pix, Pix Automático or card on Woovi and AbacatePay, inside your app.",
  "license": "MIT",
  "homepage": "https://dunasjs.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dunasjs/dunas.git",
    "directory": "packages/dunas"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client/client.ts",
    "./better-auth": "./src/integrations/better-auth.ts",
    "./node": "./src/http/node.ts",
    "./nestjs": "./src/integrations/nestjs.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./client": {
        "types": "./dist/client.d.mts",
        "default": "./dist/client.mjs"
      },
      "./better-auth": {
        "types": "./dist/better-auth.d.mts",
        "default": "./dist/better-auth.mjs"
      },
      "./node": {
        "types": "./dist/node.d.mts",
        "default": "./dist/node.mjs"
      },
      "./nestjs": {
        "types": "./dist/nestjs.d.mts",
        "default": "./dist/nestjs.mjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "@electric-sql/pglite": ">=0.3",
    "@nestjs/common": ">=10",
    "@nestjs/core": ">=10",
    "pg": ">=8"
  },
  "peerDependenciesMeta": {
    "@electric-sql/pglite": {
      "optional": true
    },
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/platform-fastify": "^12.3.2",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsdown": "^0.23.1",
    "vitest": "^5.0.5"
  }
}
